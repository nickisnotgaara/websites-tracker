TELEGRAM_BOT_TOKEN=123:ABC
TELEGRAM_ADMIN_IDS=[123456789]
OLLAMA_BASE_URL=http://localhost:11434/v1
AI_MODEL_NAME=gpt-oss:120b-cloud
SPREADSHEET_ID=

# --- Schedule ---------------------------------------------------------
# When the automatic run happens. Requires a restart of the bot.
# Days: mon, tue, wed, thu, fri, sat, sun -- comma-separated, or * for daily.
SCHEDULE_DAYS=*
SCHEDULE_HOUR=8
SCHEDULE_MINUTE=0
SCHEDULE_TZ=Europe/Moscow

# Examples:
#   twice a week      SCHEDULE_DAYS=mon,thu
#   every weekday     SCHEDULE_DAYS=mon,tue,wed,thu,fri
#   Mondays 07:15MSK  SCHEDULE_DAYS=mon   SCHEDULE_HOUR=7   SCHEDULE_MINUTE=15

# --- Live Telegram log (message that rewrites itself during a run) ---
# Master switch. false = old behaviour (plain start/finish broadcasts).
TELEGRAM_LIVE_LOG=true
# Seconds between edit attempts. Lower it if you see 429 flood errors.
TELEGRAM_LIVE_LOG_INTERVAL=3.0
# Level mirrored from loguru into the message (terminal shows INFO).
TELEGRAM_LIVE_LOG_LEVEL=INFO
# Hard floor between two API calls to the same chat (Telegram allows ~1/sec).
TELEGRAM_LIVE_LOG_MIN_GAP=1.05
# In-memory ring buffer size for log lines.
TELEGRAM_LIVE_LOG_BUFFER=2000
# Logger names never mirrored into Telegram (avoids edit -> log -> edit loops).
# MUST be valid JSON if you override it -- pydantic-settings parses this field
# as a list and a plain comma-separated value aborts startup.
# TELEGRAM_LIVE_LOG_DENY=["aiogram","aiohttp","asyncio","apscheduler","src.services.bot.livelog"]
